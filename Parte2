        "\n",
        "# Separar el texto en oraciones tokenizadas\n",
        "oraciones = [word_tokenize(linea) for linea in texto_limpio.split('\\n') if len(linea) > 5]\n",
        "\n",
        "print(\"Entrenando modelo Word2Vec...\")\n",
        "# Tarea: Puedes experimentar modificando vector_size o window más adelante\n",
        "w2v_model = Word2Vec(sentences=oraciones, vector_size=100, window=5, min_count=2, workers=4)\n",
        "print(\"¡Modelo Word2Vec propio entrenado con éxito!\")"
